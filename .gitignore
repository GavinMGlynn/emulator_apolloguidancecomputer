# Build trees (preset binaryDir = build/<preset>)
/build/

# User-supplied / downloaded media — never committed.
# Core ropes and rope-module dumps are large and license-bound; see
# docs/references/TEST_SOFTWARE.md for where each one comes from.
# (glob the contents rather than the directory: git will not look inside an
# excluded directory, so a negation for a file within one never matches)
/roms/*
/bios/*
!/roms/README.md
!/bios/README.md
*.bin
*.agc.bin

# Probe rope images are committed on purpose: they are tiny (a few dozen words
# in a sparse image), they are the input half of the golden regression, and CI
# must be able to run the probes without initialising a submodule or assembling
# anything.
!/tests/probes/*.bin

# References that are not committed. tools/fetch_docs.sh restores them (and
# everything else under docs/references) on demand.
#
#   agcis_32     94 MB, within a few megabytes of GitHub's hard per-file limit.
#   _jp2/        20 MB of page scans; the fetch script pulls them from archive.org.
#   O'Brien      Frank O'Brien's book is a current commercial publication
#                (Springer/Praxis). Everything else here is a government-funded
#                MIT/NASA report we may freely mirror; that one is not ours to
#                redistribute, so the script does not fetch it either — see
#                docs/references/README.md for where to buy it.
/docs/references/agc-information-series/agcis_32_blk2_instructions.pdf
/docs/references/the-apollo-guidance-computer_jp2/
/docs/references/L-G-*.pdf

# Editor / OS cruft
.idea/
.cache/
compile_commands.json
*.o
*.a
*.swp
.DS_Store

# Local Claude Code settings
.claude/settings.local.json

# The oracle host writes these wherever it is run from (upstream's own
# behaviour; ext/ is not patched to change it).
AGCPlusPlus.log
log_IMU_*.csv

# Python cache
__pycache__/
*.pyc
