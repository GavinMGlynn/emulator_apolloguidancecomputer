# Generated by tools/probes/gen_timing_probe.py — do not edit.
# Each measurement brackets one instruction between two sentinel stores;
# the window is cost(instruction) + 4 MCTs (one CA and one TS).
flags --ignore-counters
# name  open-sentinel  close-sentinel  expected-window-MCTs ('?' = record only)
measure CA 0120 0121 6
measure CS 0122 0123 6
measure AD 0124 0125 6
measure MASK 0126 0127 6
measure TS 0130 0131 6
measure XCH 0132 0133 6
measure LXCH 0134 0135 6
measure INCR 0136 0137 6
measure ADS 0140 0141 6
measure TC 0142 0143 5
measure TCF 0144 0145 5
measure INHINT 0146 0147 5
measure RELINT 0150 0151 5
measure INDEX 0152 0153 6
measure CCS_PLUS_TCF 0154 0155 7
measure DAS 0156 0157 7
measure DXCH 0160 0161 7
measure SU 0162 0163 7
measure MSU 0164 0165 7
measure QXCH 0166 0167 7
measure AUG 0170 0171 7
measure DIM 0172 0173 7
measure DCA 0174 0175 8
measure DCS 0176 0177 8
measure MP 0200 0201 8
measure DV 0202 0203 11
