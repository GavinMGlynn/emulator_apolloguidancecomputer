# Generated by tools/probes/gen_branch_probe.py — do not edit.
# Each window is <load A> + EXTEND + branch, plus the usual CA + TS
# overhead of 4 MCTs. A taken branch costs 1 MCT, one not taken costs 2.
flags --ignore-counters
# name  open-sentinel  close-sentinel  expected-window-MCTs
measure BZF_PLUS_ZERO 0120 0121 8
measure BZF_MINUS_ZERO 0122 0123 8
measure BZF_POSITIVE 0124 0125 9
measure BZF_NEGATIVE 0126 0127 9
measure BZMF_PLUS_ZERO 0130 0131 8
measure BZMF_MINUS_ZERO 0132 0133 8
measure BZMF_NEGATIVE 0134 0135 8
measure BZMF_POSITIVE 0136 0137 9
# Taking a branch must be cheaper than not taking one.
relation BZF_PLUS_ZERO BZF_POSITIVE b_longer_by_whole_mcts
relation BZMF_NEGATIVE BZMF_POSITIVE b_longer_by_whole_mcts
